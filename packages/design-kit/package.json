{
  "name": "@joeykwispel/design-kit",
  "version": "1.1.0",
  "description": "The design system of joeyoosenbrug.nl: tokens, base styles, components and the shared header for every *.joeyoosenbrug.nl app.",
  "author": "Joey Oosenbrug (https://github.com/joeykwispel)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeykwispel/designkit.git",
    "directory": "packages/design-kit"
  },
  "homepage": "https://designkit.joeyoosenbrug.nl",
  "bugs": "https://github.com/joeykwispel/designkit/issues",
  "keywords": [
    "design-system",
    "design-tokens",
    "css",
    "svelte",
    "react",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/header.css",
    "src/header.js",
    "src/header.d.ts",
    "src/header.html",
    "src/theme-script.js",
    "src/theme-script.d.ts",
    "src/svelte",
    "CHANGELOG.md"
  ],
  "exports": {
    "./kit.css": "./dist/kit.css",
    "./header.css": "./src/header.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./header.html": "./src/header.html",
    "./tokens.json": "./dist/tokens.json",
    "./header": {
      "types": "./src/header.d.ts",
      "default": "./src/header.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./theme-script": {
      "types": "./src/theme-script.d.ts",
      "default": "./src/theme-script.js"
    },
    "./svelte": {
      "types": "./src/svelte/index.d.ts",
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./react": {
      "types": "./dist/react/JoHeader.d.ts",
      "default": "./dist/react/JoHeader.js"
    },
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
